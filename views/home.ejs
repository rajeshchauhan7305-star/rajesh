<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduSubmit - Smart Assignment Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">EduSubmit</a>
        <div class="ms-auto d-flex gap-2 flex-wrap">
          <a class="btn btn-outline-light" href="/auth/login">Login</a>
          <a class="btn btn-light" href="/auth/register">Register</a>
          <a class="btn btn-secondary" href="/auth/login?role=teacher">Teacher</a>
          <a class="btn btn-dark" href="/auth/login?role=admin">Admin</a>
        </div>
      </div>
    </nav>

    <section class="hero-section">
      <div class="container py-5">
        <div class="row align-items-center g-5">
          <div class="col-lg-7">
            <span class="badge rounded-pill bg-info-subtle text-info-emphasis mb-3">Modern learning management experience</span>
            <h1 class="display-4 fw-bold mb-3">Submit smarter, grade faster, and track progress effortlessly.</h1>
            <p class="lead text-muted">EduSubmit helps students upload assignments securely and gives teachers dashboards, evaluations, and insightful analytics in one place.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
              <a href="/auth/register" class="btn btn-primary btn-lg">Get Started</a>
              <a href="#features" class="btn btn-outline-primary btn-lg">Explore Features</a>
            </div>
          </div>
          <div class="col-lg-5">
            <div class="card hero-card p-4 shadow-lg">
              <h5 class="fw-bold mb-3">What you can do</h5>
              <ul class="list-group list-group-flush">
                <li class="list-group-item">Upload PDF assignments securely</li>
                <li class="list-group-item">Track deadlines and late submissions</li>
                <li class="list-group-item">Provide marks and feedback instantly</li>
                <li class="list-group-item">View Python-powered analytics insights</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="container py-5">
      <div class="text-center mb-5">
        <h2 class="fw-bold">Powerful features for every role</h2>
        <p class="text-muted">Built to support students and teachers with a clean, modern workflow.</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card feature-card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="fw-bold">Secure PDF Uploads</h5>
              <p class="text-muted">Students can upload only PDF assignments with size validation and secure storage.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card feature-card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="fw-bold">Smart Dashboards</h5>
              <p class="text-muted">Role-based dashboards show key stats like pending reviews, submitted work, and deadlines.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card feature-card h-100 shadow-sm">
            <div class="card-body">
              <h5 class="fw-bold">Advanced Analytics</h5>
              <p class="text-muted">Python-based insights help teachers understand completion rates, grades, and engagement trends.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container py-5">
      <div class="row g-4 align-items-center">
        <div class="col-lg-6">
          <div class="card p-4 shadow-sm">
            <h3 class="fw-bold mb-3">Built for a smoother academic workflow</h3>
            <p class="text-muted">From assignment creation to feedback delivery, every step is streamlined for faster collaboration.</p>
            <ul>
              <li>Teacher assignment creation with validation</li>
              <li>Late submission tracking and evaluation</li>
              <li>Student progress visibility and feedback history</li>
            </ul>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="card p-4 shadow-sm">
            <h3 class="fw-bold mb-3">Why choose EduSubmit?</h3>
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-success me-3">✓</span>
              <span>Responsive and mobile-friendly design</span>
            </div>
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-success me-3">✓</span>
              <span>Secure authentication and role-based access</span>
            </div>
            <div class="d-flex align-items-center mb-3">
              <span class="badge bg-success me-3">✓</span>
              <span>Professional UI with modern Bootstrap styling</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="container pb-5">
      <div class="text-center card cta-card p-4 shadow-sm">
        <h3 class="fw-bold">Ready to transform your submission process?</h3>
        <p class="text-muted">Join EduSubmit today and make assignment handling easier for everyone.</p>
        <a href="/auth/register" class="btn btn-primary btn-lg">Create Account</a>
      </div>
    </section>
  </body>
</html>
