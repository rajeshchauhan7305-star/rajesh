<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduSubmit - Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="bg-light">
    <div class="position-absolute top-0 end-0 p-3">
      <button class="btn btn-outline-secondary btn-sm" id="theme-toggle">🌙 Dark</button>
    </div>
    <div class="container py-5">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">
              <h2 class="text-center mb-4">EduSubmit</h2>
              <% if (error) { %>
                <div class="alert alert-danger"><%= error %></div>
              <% } %>
              <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
              <% } %>
              <% if (typeof roleHint !== 'undefined') { %>
                <% if (roleHint === 'admin') { %>
                  <div class="alert alert-dark">Admin access selected</div>
                <% } else if (roleHint === 'teacher') { %>
                  <div class="alert alert-secondary">Teacher access selected</div>
                <% } else if (roleHint === 'student') { %>
                  <div class="alert alert-info">Student access selected</div>
                <% } %>
              <% } %>
              <div class="d-grid gap-2 mb-4">
                <a href="/auth/login?role=admin" class="btn btn-dark"><i class="fas fa-user-shield me-2"></i>Admin Login</a>
                <a href="/auth/login?role=teacher" class="btn btn-secondary"><i class="fas fa-chalkboard-user me-2"></i>Teacher Login</a>
                <a href="/auth/login?role=student" class="btn btn-info"><i class="fas fa-user-graduate me-2"></i>Student Login</a>
              </div>
              <hr class="my-4" />
              <form action="/auth/login" method="post">
                <div class="mb-3">
                  <label class="form-label">Email</label>
                  <input type="email" name="email" class="form-control" required />
                </div>
                <div class="mb-3">
                  <label class="form-label">Password</label>
                  <input type="password" name="password" class="form-control" required />
                </div>
                <button class="btn btn-primary w-100">Login</button>
              </form>
              <p class="mt-3 text-center">
                New here? <a href="/auth/register">Create account</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="/js/app.js"></script>
  </body>
</html>
