<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teacher Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">EduSubmit</a>
        <div class="ms-auto">
          <a class="btn btn-outline-light" href="/auth/logout">Logout</a>
        </div>
      </div>
    </nav>
    <div class="container py-4">
      <h2 class="mb-4">Teacher Dashboard</h2>
      <div class="row g-4">
        <div class="col-md-3"><div class="card p-3"><h5>Total Students</h5><h2><%= students %></h2></div></div>
        <div class="col-md-3"><div class="card p-3"><h5>Total Assignments</h5><h2><%= assignments %></h2></div></div>
        <div class="col-md-3"><div class="card p-3"><h5>Pending Reviews</h5><h2><%= pendingReviews %></h2></div></div>
        <div class="col-md-3"><div class="card p-3"><h5>Late Submissions</h5><h2><%= lateSubmissions %></h2></div></div>
      </div>
      <div class="mt-4">
        <a class="btn btn-success" href="/teacher/assignments">Manage Assignments</a>
        <a class="btn btn-outline-primary" href="/teacher/submissions">View Submissions</a>
      </div>
      <div class="row g-4 mt-2">
        <div class="col-md-6">
          <div class="card p-4">
            <h5>Python Analytics</h5>
            <p class="text-muted">Completion rate: <strong><%= analytics.completion_rate %>%</strong></p>
            <p><strong>Recommendation:</strong> <%= analytics.recommendation %></p>
            <ul>
              <% Object.entries(analytics.status_counts || {}).forEach(([status, count]) => { %>
                <li><%= status %>: <%= count %></li>
              <% }) %>
            </ul>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card p-4">
            <h5>Grade Distribution</h5>
            <ul>
              <% Object.entries(analytics.grade_distribution || {}).forEach(([grade, count]) => { %>
                <li><%= grade %>: <%= count %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      </div>
      <div class="mt-4">
        <h4>Quick Assignment Creator</h4>
        <form action="/teacher/assignments/create" method="post" class="card p-4">
          <div class="row g-3">
            <div class="col-md-6"><input class="form-control" name="subject_name" placeholder="Subject Name" required /></div>
            <div class="col-md-6"><input class="form-control" name="title" placeholder="Assignment Title" required /></div>
            <div class="col-md-12"><textarea class="form-control" name="description" placeholder="Description" required></textarea></div>
            <div class="col-md-6"><input class="form-control" type="number" name="max_marks" placeholder="Maximum Marks" required /></div>
            <div class="col-md-6"><input class="form-control" type="date" name="due_date" required /></div>
          </div>
          <button class="btn btn-success mt-3">Create Assignment</button>
        </form>
      </div>
    </div>
  </body>
</html>
