<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Assignments</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="container py-4">
      <h2 class="mb-4">Assignments</h2>
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <div class="row g-4">
        <% assignments.forEach(function(assignment){ %>
          <div class="col-md-6">
            <div class="card shadow-sm rounded-4">
              <div class="card-body">
                <h5><%= assignment.subject_name %> - <%= assignment.title %></h5>
                <p><%= assignment.description %></p>
                <p><strong>Max Marks:</strong> <%= assignment.max_marks %></p>
                <p><strong>Due Date:</strong> <%= assignment.due_date %></p>
                <% const submitted = submissionMap.get(assignment.assignment_id); %>
                <% if (submitted) { %>
                  <span class="badge bg-success">Submitted</span>
                <% } else { %>
                  <span class="badge bg-warning text-dark">Pending</span>
                <% } %>
                <a href="/student/assignment/<%= assignment.assignment_id %>" class="btn btn-primary mt-3">View Details</a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </body>
</html>
