<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">EduSubmit Admin</a>
        <div class="ms-auto">
          <a class="btn btn-outline-light" href="/auth/logout">Logout</a>
        </div>
      </div>
    </nav>
    <div class="container py-4">
      <h2 class="mb-4">Admin Dashboard</h2>
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <div class="row g-4">
        <div class="col-md-4"><div class="card p-3"><h5>Total Users</h5><h2><%= users %></h2></div></div>
        <div class="col-md-4"><div class="card p-3"><h5>Total Assignments</h5><h2><%= assignments %></h2></div></div>
        <div class="col-md-4"><div class="card p-3"><h5>Total Submissions</h5><h2><%= submissions %></h2></div></div>
      </div>
      <div class="mt-4">
        <a class="btn btn-dark" href="/admin/users">Manage Users</a>
      </div>
      <div class="mt-4 card p-4">
        <h5>Admin Quick Tips</h5>
        <ul>
          <li>Create student and teacher accounts from the user management panel.</li>
          <li>Review submissions and evaluate marks from the teacher area.</li>
          <li>Use the portal to keep academic operations organized.</li>
        </ul>
      </div>
    </div>
  </body>
</html>
